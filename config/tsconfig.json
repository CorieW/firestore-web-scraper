{
  "compilerOptions": {
    "outDir": "../lib",
    "rootDir": "../src",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noImplicitReturns": true,
    "declaration": true,
    "sourceMap": false,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "compileOnSave": true,
  "include": ["../src"],
  "exclude": ["../src/test"]
}
