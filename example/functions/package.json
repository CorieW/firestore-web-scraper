{
  "name": "firestore-web-scraper-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "deploy": "pnpm build && firebase deploy --only functions --project demo-firestore-web-scraper",
    "emulators:start": "pnpm build && firebase emulators:start --only functions,firestore --project demo-firestore-web-scraper",
    "serve": "pnpm emulators:start"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "firestore-web-scraper": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.33",
    "firebase-tools": "^14.10.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "22"
  }
}
