{
  "name": "firestore-web-scraper",
  "version": "0.2.0",
  "description": "A Firebase Functions package for processing Firestore-backed web scraping tasks.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "prepare": "pnpm build",
    "build": "pnpm clean && pnpm compile",
    "build:watch": "pnpm clean && tsc -p config/tsconfig.json --watch",
    "clean": "rimraf lib",
    "compile": "tsc -p config/tsconfig.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "start:emulator": "cd _emulator && firebase emulators:start -P demo-test",
    "local:emulator": "concurrently --kill-others -c \"blue,red\" \"pnpm start:emulator\" \"wait-on tcp:9099\"",
    "test": "firebase emulators:exec --only extensions \"pnpm test:vitest:run\" -P demo-test",
    "test:vitest": "vitest --config config/vitest.config.ts",
    "test:vitest:run": "vitest run --config config/vitest.config.ts",
    "test:vitest:watch": "vitest --watch --config config/vitest.config.ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" --config config/.prettierrc --ignore-path config/.prettierignore",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" --config config/.prettierrc --ignore-path config/.prettierignore",
    "pack:check": "pnpm pack --dry-run",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "firebase",
    "firebase-functions",
    "firestore",
    "web-scraper",
    "scraping"
  ],
  "author": "Corie Watson",
  "license": "Apache-2.0",
  "homepage": "https://github.com/CorieW/scraper-firebase-extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorieW/scraper-firebase-extension.git"
  },
  "bugs": {
    "url": "https://github.com/CorieW/scraper-firebase-extension/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "icon": "./branding/icon.png",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2 || ^7.0.0",
    "jsdom": "^24.0.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/jsdom": "^21.1.7",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.1.2",
    "firebase-tools": "^14.10.1",
    "prettier": "^3.2.5",
    "rimraf": "^2.6.3",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  }
}
